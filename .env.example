# Environment variable reference for local development.
# Frontend: copy VITE_API_BASE into frontend/.env.local before running Vite.
# Backend: export DATABASE_URL in your shell before starting the FastAPI app.

VITE_API_BASE=http://127.0.0.1:8000

# Matches the backend's default local SQLite setup when you run commands from backend/.
# If you start the backend from another directory, prefer an absolute sqlite path instead.
DATABASE_URL=sqlite:///./to_eat_list.db
